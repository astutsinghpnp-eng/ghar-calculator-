# Copy this file to .env and fill in your own key. .env is gitignored —
# never commit real credentials.

# Required for the "read dimensions from a map/photo" upload feature
# (api/extract-dimensions.js). Get a free key (no billing required) at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for lead capture (api/lead.js) to durably save submissions —
# Vercel's filesystem can't store files permanently. Create a free project
# at https://supabase.com, then Project Settings -> API for these two:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
