# Copy this file to .env and fill in your own key. .env is gitignored —
# never commit real credentials.

# Required for the "read dimensions from a map/photo" upload feature
# (api/extract-dimensions.js). Get a free key (no billing required) at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required in production (e.g. Vercel) for the persona-gate lead capture
# (api/lead.js) to actually notify you of a submission — Vercel's
# filesystem is read-only, so the local-file fallback used in dev doesn't
# work there. Get a free key (no domain/credit card needed to start) at
# https://resend.com/api-keys
RESEND_API_KEY=

# Optional — where lead notification emails are sent. Defaults to
# abhisheksinghpnp@gmail.com if unset.
LEAD_NOTIFY_EMAIL=
